{
  "parserOptions": {
    "extraFileExtensions": ["json"]
  },
  "compilerOptions": {
    "baseUrl": ".",
    "noEmit": true,
    "allowJs": true,
    "strict": false,
    "jsx": "react-jsx",
    "target": "esnext",
    "module": "esnext",
    "incremental": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    "lib": ["dom", "dom.iterable", "esnext"],
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@mgen/root": ["./"],
      "@mgen/root/*": ["./*"],
      "@mgen/deploy": ["./deploy"],
      "@mgen/deploy/*": ["./deploy/*"],
      "@mgen/backend": ["./repos/backend"],
      "@mgen/backend/*": ["./repos/backend/*"],
      "@mgen/frontend": ["./repos/frontend"],
      "@mgen/frontend/*": ["./repos/frontend/*"],
      "@keg-hub/jsutils": ["node_modules/@keg-hub/jsutils/build/cjs"],
      "@keg-hub/jsutils/*": ["node_modules/@keg-hub/jsutils/build/cjs/*"]
    }
  },
  "include": [
    "scripts"
  ]
}
